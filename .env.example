# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN upload .env ke GitHub.

PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finai

# --- Keamanan login (ganti dengan teks acak yang panjang) ---
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# --- OpenRouter ---
# Buat key di https://openrouter.ai/settings/keys (awalan sk-or-v1-)
OPENROUTER_API_KEY=
# Daftar model dicoba berurutan (dipisah koma). Kalau model pertama gagal/penuh, lanjut ke berikutnya.
# "openrouter/free" = router otomatis yang memilih model gratis yang sedang tersedia.
OPENROUTER_MODELS=openrouter/free
